---
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import NewsletterDialog from '../components/ui/NewsletterDialog.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/landing.css';
import { withBase } from '../lib/urls';
import { SITE_DESCRIPTION } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  sampleMode?: boolean;
}
const { title, description = SITE_DESCRIPTION, canonicalPath, noindex = false, sampleMode = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ff" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <SeoHead title={title} description={description} canonicalPath={canonicalPath} noindex={noindex || sampleMode} />
    <slot name="head" />
    <noscript><style>.theme-label, [data-newsletter-open] { display: none !important; }</style></noscript>
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (_) {}
    </script>
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true" hidden></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {sampleMode && <div class="sample-banner" role="status">SAMPLE PREVIEW — DEMO JOBS, NOT LIVE OPENINGS</div>}
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <button class="back-to-top" data-back-to-top type="button" aria-label="Back to top" title="Back to top" tabindex="-1" hidden>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="m6 12 6-6 6 6M12 6v13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <NewsletterDialog />
    <script>
      import '../scripts/theme';
      import '../scripts/motion';
    </script>
  </body>
</html>
