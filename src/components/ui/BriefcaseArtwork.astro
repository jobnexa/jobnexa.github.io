<div class="briefcase-art" aria-hidden="true">
  <svg viewBox="0 0 540 470" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false" style="display:block;width:100%;height:auto;overflow:visible">
    <defs>
      <linearGradient id="case-body" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#274b9c" />
        <stop offset=".5" stop-color="#183a85" />
        <stop offset="1" stop-color="#102b68" />
      </linearGradient>
      <linearGradient id="case-front" x1="0" y1="0" x2=".9" y2="1">
        <stop offset="0" stop-color="#fffef8" />
        <stop offset=".54" stop-color="#ecf4f4" />
        <stop offset="1" stop-color="#c9dced" />
      </linearGradient>
      <linearGradient id="case-side" x1="0" y1="0" x2="1" y2=".8">
        <stop offset="0" stop-color="#15346f" />
        <stop offset="1" stop-color="#092252" />
      </linearGradient>
      <linearGradient id="case-lime" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#eaffaa" />
        <stop offset="1" stop-color="#b7ec59" />
      </linearGradient>
      <filter id="case-floor-blur" x="-30%" y="-100%" width="160%" height="300%">
        <feGaussianBlur stdDeviation="13" />
      </filter>
      <filter id="case-drop" x="-25%" y="-25%" width="150%" height="165%">
        <feDropShadow dx="0" dy="20" stdDeviation="13" flood-color="#071c4c" flood-opacity=".26" />
      </filter>
    </defs>

    <ellipse cx="274" cy="422" rx="179" ry="20" fill="#071d57" opacity=".24" filter="url(#case-floor-blur)" />

    <g class="briefcase-float" filter="url(#case-drop)">
      <!-- A quiet document corner adds scale without competing with the bag. -->
      <g transform="rotate(10 401 174)">
        <rect x="358" y="112" width="77" height="101" rx="10" fill="#f6f7ee" />
        <path d="M372 140h48M372 153h37M372 166h43" fill="none" stroke="#a7bdda" stroke-width="5" stroke-linecap="round" />
        <path d="M400 112v18q0 7 7 7h28" fill="#dce8e5" stroke="#dce8e5" stroke-width="3" />
      </g>

      <!-- Substantial inset handle, attached behind the top seam. -->
      <path d="M217 158v-34c0-24 16-39 40-39h32c24 0 40 15 40 39v34" fill="none" stroke="#0d2c6d" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M224 148v-23c0-21 13-33 34-33h30c21 0 34 12 34 33v23" fill="none" stroke="#5775b8" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity=".7" />
      <path d="M237 158v-30c0-12 8-20 20-20h32c12 0 20 8 20 20v30" fill="none" stroke="#c9d7e9" stroke-width="7" stroke-linecap="round" />

      <!-- Back shell and the darker right gusset give the case real depth. -->
      <rect x="76" y="153" width="390" height="249" rx="31" fill="url(#case-side)" />
      <path d="M435 155h10c16 0 27 13 27 29v183c0 22-12 35-31 35h-10c13-9 17-21 17-37V188c0-14-4-25-13-33Z" fill="#091f52" opacity=".76" />
      <rect x="71" y="151" width="380" height="239" rx="29" fill="url(#case-body)" stroke="#6480bd" stroke-width="2" />
      <path d="M78 356h365v7c0 14-11 25-25 25H104c-14 0-26-11-26-25v-7Z" fill="#0c2762" opacity=".55" />
      <path d="M96 172h17v190H96" fill="none" stroke="#6682bf" stroke-width="3" opacity=".48" />
      <path d="M420 172h12v190h-12" fill="none" stroke="#09265e" stroke-width="4" opacity=".5" />

      <!-- Pale structured flap across the shoulders, curved into the clasp. -->
      <path d="M102 150h318c18 0 30 13 30 31v69c-47 37-108 58-187 58S132 286 72 250v-69c0-18 12-31 30-31Z" fill="url(#case-front)" stroke="#d9e6ef" stroke-width="2" />
      <path d="M74 251c55 36 115 56 189 56s140-21 186-56" fill="none" stroke="#a9c4dc" stroke-width="3" opacity=".75" />
      <path d="M103 163h316c9 0 16 5 18 14H85c2-9 9-14 18-14Z" fill="#fff" opacity=".67" />
      <path d="M105 193h125" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".42" />

      <!-- Paired vertical webbing straps continue under the flap. -->
      <path d="M145 296v89M381 296v89" stroke="#09295f" stroke-width="19" opacity=".64" />
      <path d="M145 309v67M381 309v67" stroke="#6983bf" stroke-width="4" opacity=".54" />
      <rect x="133" y="335" width="24" height="19" rx="5" fill="#bedf8c" />
      <rect x="369" y="335" width="24" height="19" rx="5" fill="#bedf8c" />

      <!-- Lime clasp is the focal point and the visual hinge of the flap. -->
      <rect x="233" y="281" width="60" height="73" rx="13" fill="#0b2864" />
      <rect x="239" y="288" width="48" height="55" rx="10" fill="url(#case-lime)" stroke="#f2ffc9" stroke-width="2" />
      <rect x="251" y="302" width="24" height="15" rx="5" fill="#194078" />
      <path d="M255 312h16" stroke="#719d45" stroke-width="2" stroke-linecap="round" />
      <path d="M249 331h28" stroke="#7aae4b" stroke-width="3" stroke-linecap="round" opacity=".8" />

      <!-- Low seam, feet and restrained metal hardware. -->
      <path d="M106 374h306" stroke="#5f7dbc" stroke-width="3" stroke-linecap="round" opacity=".6" />
      <rect x="105" y="389" width="34" height="12" rx="4" fill="#0a2459" />
      <rect x="386" y="389" width="34" height="12" rx="4" fill="#0a2459" />
      <path d="M97 251v31M430 251v31" stroke="#d4e6f0" stroke-width="5" stroke-linecap="round" opacity=".58" />
    </g>

    <path d="m75 102 6 14 14 6-14 6-6 14-6-14-14-6 14-6Z" fill="#dcff83" opacity=".9" />
    <path d="m450 88 4 9 9 4-9 4-4 9-4-9-9-4 9-4Z" fill="#f4f7e9" opacity=".76" />
    <rect x="470" y="319" width="13" height="13" rx="3" fill="#d9ff7c" transform="rotate(18 476 325)" opacity=".82" />
  </svg>
</div>
