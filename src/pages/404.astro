---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../lib/site';
import { withBase } from '../lib/urls';
---
<BaseLayout title={`Page not found | ${SITE_NAME}`} description="The page you are looking for may have moved or been removed." canonicalPath="/404.html" noindex>
  <section class="container empty-state information-page">
    <p class="eyebrow">404</p><h1>Page not found</h1>
    <p>This page may have moved or been removed. You can still browse the available jobs.</p>
    <a class="button" href={withBase('/jobs/')}>Browse jobs</a>
  </section>
</BaseLayout>
